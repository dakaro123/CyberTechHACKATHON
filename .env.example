# Copy to .env (never commit .env). All values are optional.

# Port for the API (and the built web app in `npm start`).
PORT=8787

# live (default): real Wise quotes. offline: never call Wise, use offline rates (rehearse without network).
FX_MODE=live

# Wise sandbox token (https://wise-sandbox.com → Settings → API tokens).
# Without a token the app uses Wise's public quote endpoint on https://api.wise.com (live rates).
WISE_API_TOKEN=
# Profile id for quotes; defaults to the token's first personal profile.
WISE_PROFILE_ID=
# Override the API base URL. Defaults: https://api.wise.com (no token), https://api.wise-sandbox.com (token).
WISE_API_BASE=
WISE_TIMEOUT_MS=5000
