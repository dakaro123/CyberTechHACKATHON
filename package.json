{
  "name": "wise-flow",
  "version": "0.1.0",
  "private": true,
  "description": "Wise Flow: payday planner proof of concept. Salary in, protected plan out (live Wise FX quotes), smart spending jars.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "tsx server/src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p server/tsconfig.json && tsc -p web/tsconfig.json"
  },
  "dependencies": {
    "@fontsource/epilogue": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "material-symbols": "^0.49.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.7",
    "postcss": "^8.5.32",
    "supertest": "^7.3.2",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
